{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ct-analytics",
  // Secrets are not declared here; set them with `wrangler secret put <NAME>`:
  //   STATS_TOKEN   bearer token for the admin/stats routes (required)
  //   IP_HASH_SALT  salt for client-IP hashing; optional, falls back to STATS_TOKEN
  "main": "src/index.ts",
  "account_id": "9aee479fccde79fa86e9aa788a3c418e",
  "compatibility_date": "2025-02-04",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 3 * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "KV_BINDING",
      "id": "8d7e4237d2284ed6b9ecbab1bdebe9a3"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ct-analytics-db",
      "database_id": "cedefc3c-2992-48aa-98b2-b8380670db92"
    }
  ]
}
